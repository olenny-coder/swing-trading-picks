# =============================================================================
# Swing Trading Picks — environment configuration
# Copy to `.env` and fill in. Every value here has a safe default for the
# built-in MOCK demo mode, so the app runs end-to-end with zero external keys.
# =============================================================================

# --- App / security ----------------------------------------------------------
# Master secret used to derive the Fernet key that encrypts API keys at rest.
# MUST be changed in production (any long random string).
SECRET_KEY=change-me-to-a-long-random-string

# JWT token lifetime (minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=720

# --- Database ----------------------------------------------------------------
# SQLite is the zero-config default (great for the demo).
# For production use PostgreSQL (+ optional TimescaleDB):
#   postgresql+psycopg2://user:pass@host:5432/swingtrader
DATABASE_URL=sqlite:///./swingtrader.db

# --- Data provider selection --------------------------------------------------
# "auto" -> uses Alpaca when API keys are configured, otherwise falls back to
# the deterministic MOCK provider. Also accepts "alpaca" or "mock".
DATA_PROVIDER=auto

# --- Alpaca (market data + optional paper trading) ---------------------------
# Leave blank to run the MOCK demo. These can also be set from the Settings UI,
# in which case UI values (stored encrypted in the DB) take precedence.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true                # "true" -> paper endpoint, "false" -> live
ALPACA_DATA_FEED=iex             # iex (free) or sip

# --- Optional macro / earnings / options providers ---------------------------
# All optional. When absent, the app uses built-in simulated macro & earnings
# calendars so the full feature set is still demonstrable.
FINNHUB_API_KEY=
POLYGON_API_KEY=
FRED_API_KEY=

# --- LLM research agent (Groq free tier) -------------------------------------
# Free key: https://console.groq.com/keys
# The agent annotates existing signals with sentiment, risk flags and a bounded
# confidence adjustment. Without a key the rest of the app works unchanged
# (the Daily View just shows "Research agent: no Groq key").
GROQ_API_KEY=
# Free-plan models: openai/gpt-oss-120b (default), openai/gpt-oss-20b,
# llama-3.3-70b-versatile, llama-3.1-8b-instant (see console.groq.com/docs/models).
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT_SECONDS=45
GROQ_MAX_RETRIES=2

# Research agent behaviour. The free plan is capped on requests AND tokens per
# minute, so prompts are kept small and calls are sequential.
LLM_RESEARCH_ENABLED=true
LLM_RESEARCH_MAX_SIGNALS=20        # signals annotated per run
LLM_RESEARCH_MAX_TOKENS=700        # completion budget per signal
LLM_MAX_CONFIDENCE_DELTA=15        # hard clamp on the LLM's adjustment
LLM_RESEARCH_PAUSE_SECONDS=1.0     # pause between per-signal calls

# --- Scheduler ---------------------------------------------------------------
# Cron expressions for the daily jobs (UTC).
# 12:30 UTC = 8:30 PM Singapore time (SGT, UTC+8). Ingest -> macro -> signals.
CRON_INGEST_DAILY=30 12 * * *
CRON_GENERATE_SIGNALS=40 12 * * *
CRON_INGEST_MACRO=35 12 * * *

# Set true on hosts that aren't always-on (free tiers like Render). The daily
# pull then runs via GitHub Actions cron (see .github/workflows/daily-cron.yml).
DISABLE_SCHEDULER=false

# --- Static frontend (single-service deployment) ------------------------------
# Directory holding the exported frontend (frontend/out after `npm run build`).
# When present, FastAPI serves the UI at "/" so the whole app runs as ONE
# service (Render + Neon, no Vercel and no Node server).
# In Docker the image sets this to /app/static.
STATIC_DIR=static

# --- CORS (comma-separated origins) ------------------------------------------
# Only needed when the frontend is hosted on a different origin. Same-origin
# single-service deployments need no CORS at all.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Single-user admin credentials (first-run bootstrap) ---------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
